# Copia este archivo como .env.local y completa los valores.
# Supabase → Project Settings → API

# URL del proyecto (pública)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave pública: "publishable" (sb_publishable_...) o la "anon" clásica
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave de servidor: "secret" (sb_secret_...) o "service_role".
# SECRETA: nunca la subas a GitHub ni le pongas el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
